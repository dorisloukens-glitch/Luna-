<!doctype html>
<html lang="ht"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#050b14">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>World X Luna</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap">
<style>
/* Layout: one phone-sized app (glass panels, 3D chart, globe, orb buttons) centered on a stage; side menu on desktop only. */
:root{
  --bg:#030a14; --bg2:#06162a; --panel:#0a1f36; --line:rgba(120,230,255,.2);
  --cyan:#38e8ff; --cyan2:#1aa7c4; --ice:#c4f7ff; --amber:#ffb86b; --mint:#4df0a8; --rose:#ff6b86; --violet:#9b8cff;
  --text:#e6f7ff; --muted:#86a9bd; --glass:linear-gradient(150deg,rgba(56,232,255,.13),rgba(56,232,255,.03));
  --display:'Chakra Petch','Segoe UI',system-ui,sans-serif; --body:'Manrope',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:radial-gradient(1200px 700px at 70% -10%,#0b2a48 0%,transparent 60%),radial-gradient(900px 600px at 0% 100%,#06324a 0%,transparent 55%),var(--bg);color:var(--text);font-family:var(--body);font-size:14px;
  padding-block:10px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));overflow-x:hidden}
body::after{content:"";position:fixed;inset:0;pointer-events:none;background:linear-gradient(rgba(56,232,255,.035) 1px,transparent 1px) 0 0/100% 44px,linear-gradient(90deg,rgba(56,232,255,.035) 1px,transparent 1px) 0 0/44px 100%;mask-image:radial-gradient(circle at 50% 40%,#000,transparent 75%)}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer;padding:0}
input,select{font:inherit;color:var(--text)}
:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.stage{height:100%;display:flex;align-items:center;justify-content:center;gap:56px;position:relative;z-index:1}
.side{width:290px;display:none;flex-direction:column;gap:18px}
.side h1{font-family:var(--display);font-size:30px;line-height:1.05;margin:0;letter-spacing:.04em;text-transform:uppercase}
.side h1 span{color:var(--cyan);text-shadow:0 0 24px rgba(56,232,255,.6)}
.side p{margin:0;color:var(--muted);line-height:1.55}
.side .lab{font-family:var(--display);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.jump{display:flex;flex-wrap:wrap;gap:6px}
.jump button,.seg button{padding:7px 12px;border-radius:999px;border:1px solid var(--line);color:var(--muted);font-size:12.5px;font-weight:600;transition:.2s}
.jump button:hover,.seg button:hover{color:var(--ice);border-color:var(--cyan)}
.seg{display:inline-flex;gap:4px;padding:4px;border-radius:999px;border:1px solid var(--line);background:rgba(3,10,20,.6)}
.seg button{border:0}
.seg button.on{background:linear-gradient(180deg,rgba(56,232,255,.35),rgba(56,232,255,.12));color:var(--ice);box-shadow:0 0 16px -4px var(--cyan)}
@media(min-width:960px){.side{display:flex}}
.phone{position:relative;width:392px;max-width:100%;height:min(840px,100%);border-radius:44px;border:1px solid rgba(120,230,255,.35);background:radial-gradient(420px 300px at 0% 0%,rgba(255,184,107,.1),transparent 60%),radial-gradient(500px 360px at 80% -5%,rgba(56,232,255,.16),transparent 65%),linear-gradient(180deg,#061327,#030a14 70%);
  box-shadow:0 0 0 8px #06101d,0 0 0 9px rgba(120,230,255,.28),0 60px 120px -30px rgba(56,232,255,.4);overflow:hidden;display:flex;flex-direction:column;perspective:1100px}
@media(max-width:600px){.phone{width:100%;height:100%;border-radius:28px;box-shadow:0 0 0 1px rgba(120,230,255,.3),0 30px 80px -30px rgba(56,232,255,.4)}}
.view{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;padding:16px 16px 112px;display:flex;flex-direction:column;gap:14px;scrollbar-width:thin;scrollbar-color:rgba(56,232,255,.3) transparent}
.view>*{flex-shrink:0}
.ic{width:20px;height:20px;flex:none}
h1,h2,h3{font-family:var(--display);margin:0;font-weight:600;letter-spacing:.02em}
h2{font-size:15px;letter-spacing:.06em;text-transform:uppercase;color:var(--ice)}
.muted{color:var(--muted)} .num{font-family:var(--display);font-variant-numeric:tabular-nums}
.tiny{font-size:12px}
/* Glass + 3D tilt */
.glass{position:relative;border-radius:20px;border:1px solid var(--line);background:var(--glass);padding:16px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.14),inset 0 -20px 40px -30px rgba(56,232,255,.25),0 22px 40px -22px rgba(0,0,0,.85),0 0 28px -14px var(--cyan)}
[data-tilt]{transform-style:preserve-3d;transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .25s ease-out}
.pop,.pop2{transition:transform .25s ease-out}
[data-tilt]:hover .pop{transform:translateZ(22px)} [data-tilt]:hover .pop2{transform:translateZ(38px)}
.flat [data-tilt],.flat .pop,.flat .pop2{transform:none!important}
.card-h{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11.5px;font-weight:700;letter-spacing:.02em;border:1px solid var(--line);color:var(--ice);background:rgba(56,232,255,.08);white-space:nowrap}
.chip.todo{color:var(--muted);background:rgba(134,169,189,.1);border-color:rgba(134,169,189,.3)}
.chip.doing{color:var(--cyan)} .chip.done{color:var(--mint);background:rgba(77,240,168,.1);border-color:rgba(77,240,168,.35)}
.chip.late{color:var(--amber);background:rgba(255,184,107,.1);border-color:rgba(255,184,107,.4)}
.chip.vio{color:var(--violet);background:rgba(155,140,255,.1);border-color:rgba(155,140,255,.4)}
.dot{width:8px;height:8px;border-radius:50%;background:currentColor;box-shadow:0 0 10px currentColor}
.pulse{animation:pl 1.6s infinite}@keyframes pl{50%{opacity:.35}}
.av{--h:195;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;flex:none;font-family:var(--display);font-weight:700;font-size:13px;color:#021018;background:radial-gradient(circle at 30% 25%,hsl(var(--h) 100% 88%),hsl(var(--h) 90% 55%) 60%,hsl(var(--h) 90% 32%));box-shadow:0 6px 14px -4px hsl(var(--h) 90% 50%/.6),inset 0 1px 0 rgba(255,255,255,.6)}
.av.sm{width:30px;height:30px;font-size:11px}.av.lg{width:64px;height:64px;font-size:22px}
.ib{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;border:1px solid var(--line);background:linear-gradient(160deg,rgba(56,232,255,.16),rgba(56,232,255,.04));color:var(--ice);position:relative;flex:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 8px 16px -8px #000}
.ib:hover{border-color:var(--cyan);box-shadow:0 0 18px -4px var(--cyan)}
.badge{position:absolute;top:-5px;right:-5px;min-width:18px;height:18px;border-radius:9px;background:var(--amber);color:#1a0f00;font:700 10.5px var(--display);display:grid;place-items:center;padding:0 4px}
.top{display:flex;align-items:center;gap:12px}
.top .who{flex:1;min-width:0}
.top .who b{display:block;font-family:var(--display);font-size:18px;letter-spacing:.02em}
.top .who span{display:block;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sub{display:flex;align-items:center;gap:12px}
.sub h1{flex:1;font-size:20px;letter-spacing:.04em;text-transform:uppercase}
.search{display:flex;align-items:center;gap:10px;height:50px;padding:0 16px;border-radius:16px;border:1px solid var(--line);background:rgba(3,10,20,.65);box-shadow:inset 0 2px 10px rgba(0,0,0,.5),0 0 0 0 rgba(56,232,255,0);transition:.2s;color:var(--muted)}
.search:focus-within{border-color:var(--cyan);box-shadow:inset 0 2px 10px rgba(0,0,0,.5),0 0 24px -6px var(--cyan);color:var(--cyan)}
.search input{flex:1;min-width:0;background:none;border:0;outline:0;font-size:15px}
.search input::placeholder{color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:46px;padding:0 20px;border-radius:14px;font-family:var(--display);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:13px;color:#021018;background:linear-gradient(180deg,#8ff3ff,#26cfee 60%,#139dbd);box-shadow:0 5px 0 #0a5f7c,0 14px 28px -8px rgba(56,232,255,.55),inset 0 1px 0 rgba(255,255,255,.7);transition:transform .1s,box-shadow .1s}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 #0a5f7c,0 6px 14px -8px rgba(56,232,255,.55),inset 0 1px 0 rgba(255,255,255,.7)}
.btn.ghost{color:var(--ice);background:linear-gradient(160deg,rgba(56,232,255,.16),rgba(56,232,255,.04));border:1px solid var(--line);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 5px 0 rgba(4,40,60,.9)}
.btn.mint{background:linear-gradient(180deg,#b6ffe0,#4df0a8 60%,#1fb877);box-shadow:0 5px 0 #0d6a46,0 14px 28px -8px rgba(77,240,168,.5),inset 0 1px 0 rgba(255,255,255,.7)}
.btn.sm{height:36px;padding:0 14px;font-size:12px;border-radius:12px;box-shadow:0 3px 0 #0a5f7c,0 10px 18px -8px rgba(56,232,255,.5),inset 0 1px 0 rgba(255,255,255,.7)}
.btn.block{width:100%}
.field{display:flex;flex-direction:column;gap:6px}
.field label{font:600 11px var(--display);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.field input,.field select{height:48px;padding:0 14px;border-radius:14px;border:1px solid var(--line);background:rgba(3,10,20,.65);outline:0;box-shadow:inset 0 2px 8px rgba(0,0,0,.5)}
.field input:focus,.field select:focus{border-color:var(--cyan);box-shadow:inset 0 2px 8px rgba(0,0,0,.5),0 0 20px -6px var(--cyan)}
.row{display:flex;align-items:center;gap:12px;min-width:0}
.row>.grow{flex:1;min-width:0}
.row b{display:block;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row small{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.list{display:flex;flex-direction:column;gap:10px}
.item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:16px;border:1px solid var(--line);background:linear-gradient(150deg,rgba(56,232,255,.09),rgba(56,232,255,.02));text-align:left;width:100%;min-width:0;transition:.2s}
button.item:hover{border-color:var(--cyan);box-shadow:0 0 22px -8px var(--cyan)}
.state{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;flex:none;background:rgba(56,232,255,.1);color:var(--cyan);border:1px solid var(--line)}
.state.done{color:var(--mint);background:rgba(77,240,168,.1);border-color:rgba(77,240,168,.35)}
.state.late{color:var(--amber);background:rgba(255,184,107,.1);border-color:rgba(255,184,107,.4)}
.state.todo{color:var(--muted);background:rgba(134,169,189,.08)}
.filters{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.filters button{padding:8px 14px;border-radius:999px;border:1px solid var(--line);color:var(--muted);font-weight:700;font-size:12.5px;white-space:nowrap}
.filters button.on{color:var(--ice);background:rgba(56,232,255,.16);border-color:var(--cyan);box-shadow:0 0 16px -6px var(--cyan)}
/* Tab dock */
.tabs{position:absolute;left:12px;right:12px;bottom:12px;display:grid;grid-template-columns:repeat(5,1fr);padding:8px 6px;border-radius:26px;border:1px solid var(--line);background:linear-gradient(180deg,rgba(14,48,78,.92),rgba(5,18,34,.96));box-shadow:0 20px 40px -10px #000,0 0 30px -10px var(--cyan),inset 0 1px 0 rgba(255,255,255,.14);z-index:5}
.tabs button{display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;color:var(--muted);font-size:10.5px;font-weight:700;letter-spacing:.04em;transition:.25s;position:relative}
.tabs button .ic{width:23px;height:23px;transition:.25s}
.tabs button.on{color:var(--cyan)}
.tabs button.on .ic{transform:translateY(-5px) scale(1.15);filter:drop-shadow(0 0 8px var(--cyan)) drop-shadow(0 8px 6px rgba(0,0,0,.6))}
.tabs button.on::after{content:"";position:absolute;bottom:-1px;width:26px;height:3px;border-radius:2px;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}
.tabs .badge{top:0;right:calc(50% - 20px)}
/* ring */
.ring{position:relative;width:132px;height:132px;flex:none}
.ring svg{width:100%;height:100%;transform:rotate(-90deg);filter:drop-shadow(0 0 10px rgba(56,232,255,.55))}
.ring .c{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.ring .c b{font:700 30px var(--display)}.ring .c span{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.stats{display:grid;gap:8px;flex:1;min-width:0}
.stat{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 12px;border-radius:12px;background:rgba(3,10,20,.5);border:1px solid var(--line)}
.stat b{font:700 20px var(--display)}
.stat span{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);font-weight:600}
/* 3D bars */
.scene{perspective:820px;height:210px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:34px;cursor:grab;touch-action:pan-y}
.stage3d{position:relative;display:flex;gap:18px;align-items:flex-end;height:150px;transform-style:preserve-3d;transform:rotateX(var(--sx,-22deg)) rotateY(var(--sy,-24deg));transition:transform .2s ease-out}
.floorp{position:absolute;left:-26px;right:-26px;bottom:0;height:62px;transform-origin:50% 100%;transform:translateZ(31px) rotateX(90deg);border:1px solid var(--line);border-radius:6px;
  background:linear-gradient(rgba(56,232,255,.3) 1px,transparent 1px) 0 0/100% 15px,linear-gradient(90deg,rgba(56,232,255,.3) 1px,transparent 1px) 0 0/22px 100%,rgba(56,232,255,.06);box-shadow:0 0 40px rgba(56,232,255,.25)}
.bar{position:relative;width:24px;height:4px;transform-style:preserve-3d}
.grow .bar{height:var(--h);transition:height .9s cubic-bezier(.2,.8,.2,1);transition-delay:calc(var(--i)*70ms)}
.bar i{position:absolute;display:block}
.bar .f{inset:0;transform:translateZ(12px);background:linear-gradient(180deg,#7ff1ff,#1db8dc 55%,#0e789b);box-shadow:inset 0 0 0 1px rgba(255,255,255,.25),0 0 18px rgba(56,232,255,.35)}
.bar .r{top:0;right:-12px;width:24px;height:100%;transform:rotateY(90deg);background:linear-gradient(180deg,#1a9cc4,#0a5578)}
.bar .t{left:0;top:-12px;width:100%;height:24px;transform:rotateX(90deg);background:#c9faff;box-shadow:0 0 16px #8ff3ff}
.bar.hi .f{background:linear-gradient(180deg,#fff,#a8f7ff 40%,#38e8ff);box-shadow:0 0 28px rgba(196,247,255,.7)}
.bar .lbl{position:absolute;top:100%;left:50%;transform:translate(-50%,36px) translateZ(34px);font:600 10.5px var(--display);color:var(--muted);letter-spacing:.06em;white-space:nowrap}
.bar.hi .lbl{color:var(--ice)}
.bar .val{position:absolute;bottom:100%;left:50%;transform:translate(-50%,-14px) translateZ(12px);font:700 12px var(--display);color:var(--ice);text-shadow:0 0 10px var(--cyan)}
.hint{font-size:11.5px;color:var(--muted);text-align:center;margin-top:10px}
/* rank */
.rank{display:flex;flex-direction:column;gap:12px}
.rk{display:grid;grid-template-columns:30px 1fr 34px;align-items:center;gap:10px}
.rk .tr{height:9px;border-radius:5px;background:rgba(3,10,20,.7);box-shadow:inset 0 1px 3px #000;overflow:hidden}
.rk .tr i{display:block;height:100%;border-radius:5px;background:linear-gradient(90deg,var(--cyan2),var(--cyan));box-shadow:0 0 14px var(--cyan);width:0;transition:width 1s cubic-bezier(.2,.8,.2,1)}
.rk.low .tr i{background:linear-gradient(90deg,#b86f1a,var(--amber));box-shadow:0 0 14px var(--amber)}
.rk .n{font:700 14px var(--display);text-align:right}
.tl{display:grid;grid-template-columns:70px 1fr 44px;align-items:center;gap:10px;margin-bottom:11px}
.tl:last-child{margin-bottom:0}
.tl .tr{position:relative;height:2px;background:rgba(120,230,255,.25)}
.tl .tr i{position:absolute;top:-5px;width:12px;height:12px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan);transform:translateX(-50%)}
.tl .tr i.l{background:var(--amber);box-shadow:0 0 12px var(--amber)}
.tl .tr s{position:absolute;left:33.3%;top:-9px;height:20px;border-left:1px dashed rgba(255,255,255,.3)}
.tl span{font:600 12px var(--display);text-align:right}
.tl .nm{font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* orb */
.orbwrap{position:relative;height:250px;display:grid;place-items:center;perspective:700px}
.rings{position:absolute;width:250px;height:250px;transform:rotateX(68deg) translateY(38px);transform-style:preserve-3d;pointer-events:none}
.rings i{position:absolute;inset:0;border-radius:50%;border:1.5px solid rgba(56,232,255,.5);box-shadow:0 0 22px rgba(56,232,255,.4),inset 0 0 22px rgba(56,232,255,.25);animation:rg 3.2s infinite ease-out;opacity:0}
.rings i:nth-child(2){animation-delay:1.05s}.rings i:nth-child(3){animation-delay:2.1s}
@keyframes rg{0%{transform:scale(.45);opacity:.9}100%{transform:scale(1.05);opacity:0}}
.orb{--a:#b8fbff;--b:#2fd6f2;--c:#0a6f94;--d:#06506d;--g:rgba(56,232,255,.6);position:relative;z-index:2;width:164px;height:164px;border-radius:50%;display:grid;place-content:center;gap:4px;text-align:center;font-family:var(--display);font-weight:700;color:#021018;
  background:radial-gradient(circle at 35% 26%,var(--a),var(--b) 40%,var(--c) 82%);box-shadow:0 14px 0 var(--d),0 34px 50px -8px var(--g),inset 0 5px 12px rgba(255,255,255,.65),inset 0 -12px 24px rgba(0,0,0,.25);transition:transform .12s,box-shadow .12s;transform:translateY(-8px)}
.orb:active{transform:translateY(2px);box-shadow:0 4px 0 var(--d),0 14px 30px -8px var(--g),inset 0 5px 12px rgba(255,255,255,.65),inset 0 -12px 24px rgba(0,0,0,.25)}
.orb .ic{width:36px;height:36px;margin:0 auto;stroke-width:2.2}
.orb b{font-size:16px;letter-spacing:.1em;text-transform:uppercase}
.orb.mint{--a:#d4ffec;--b:#4df0a8;--c:#12805a;--d:#0b5f42;--g:rgba(77,240,168,.6)}
.orb.amber{--a:#ffe9c9;--b:#ffb86b;--c:#a3560a;--d:#6e3a06;--g:rgba(255,184,107,.55)}
.orb.off{--a:#3a5b70;--b:#27465a;--c:#183142;--d:#0e1f2c;--g:rgba(0,0,0,0);color:var(--muted);cursor:default}
.orb.sm{width:132px;height:132px}
.timer{font:700 34px var(--display);text-align:center;font-variant-numeric:tabular-nums;letter-spacing:.06em;text-shadow:0 0 18px var(--cyan)}
.steps{display:flex;flex-direction:column;gap:0}
.st{display:flex;gap:12px;align-items:flex-start;position:relative;padding-bottom:16px}
.st:last-child{padding-bottom:0}
.st::before{content:"";position:absolute;left:11px;top:24px;bottom:0;width:2px;background:rgba(120,230,255,.2)}
.st:last-child::before{display:none}
.st i{width:24px;height:24px;border-radius:50%;border:2px solid var(--line);flex:none;display:grid;place-items:center;background:var(--bg2)}
.st.on i{border-color:var(--cyan);background:var(--cyan);color:#021018;box-shadow:0 0 14px var(--cyan)}
.st.on i .ic{width:14px;height:14px;stroke-width:3}
.st b{display:block}.st small{color:var(--muted);font-size:12px}
/* chat */
.msgs{display:flex;flex-direction:column;gap:10px;flex:1}
.m{max-width:80%;padding:10px 14px;border-radius:18px 18px 18px 6px;background:linear-gradient(150deg,rgba(56,232,255,.12),rgba(56,232,255,.04));border:1px solid var(--line);line-height:1.45;overflow-wrap:anywhere}
.m small{display:block;color:var(--muted);font-size:11px;margin-top:4px;text-align:right}
.m .by{display:block;font:700 11px var(--display);letter-spacing:.06em;color:var(--cyan);margin-bottom:3px}
.m.me{align-self:flex-end;border-radius:18px 18px 6px 18px;background:linear-gradient(160deg,#2ad3ef,#0f87aa);color:#021018;border-color:rgba(255,255,255,.3);box-shadow:0 10px 20px -10px var(--cyan)}
.m.me small{color:rgba(2,16,24,.7)}
